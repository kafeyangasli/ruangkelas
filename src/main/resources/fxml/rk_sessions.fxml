<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minHeight="400.0" minWidth="600.0" spacing="16.0" stylesheets="@../css/cupertino-light.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SessionController">
   <children>
      <HBox spacing="8.0">
         <children>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="sessionTitle" prefWidth="200.0" text="Session XX">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="sessionTopic" text="Topic: XXX">
                     <font>
                        <Font name="System Italic" size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#editSessionBtn" prefHeight="40.0" prefWidth="75.0" text="Edit" />
            <Button alignment="CENTER" layoutX="488.0" layoutY="10.0" mnemonicParsing="false" onAction="#deleteSessionBtn" prefHeight="40.0" prefWidth="75.0" text="Delete" />
         </children>
      
      </HBox>
      <VBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="16.0" VBox.vgrow="SOMETIMES">
               <children>
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Session Notes" />
                        <TextArea fx:id="sessionNoteArea" prefHeight="125.0" prefWidth="325.0" promptText="Keep track of your session history here; such as list of active students or questions you require to clarify next session." wrapText="true" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Session Information" />
                        <VBox>
                           <children>
                              <Label text="Start Time:" wrapText="true" />
                              <Label fx:id="startTimeLabel" text="start" wrapText="true">
                                 <font>
                                    <Font name="System Italic" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                              <Label text="End Time:" wrapText="true" />
                              <Label fx:id="endTimeLabel" text="end" wrapText="true">
                                 <font>
                                    <Font name="System Italic" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                              <Label text="Total Duration:" wrapText="true" />
                              <Label fx:id="durationLabel" text="duration" wrapText="true">
                                 <font>
                                    <Font name="System Italic" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Separator />
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox maxWidth="1.7976931348623157E308" spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <TextField fx:id="attendeeSearchField" prefWidth="276.0" promptText="Search by NIM or name" />
                        <ListView fx:id="attendeeListView" prefHeight="150.0" prefWidth="328.0" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
                  <VBox maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="8.0">
                           <children>
                              <VBox spacing="8.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Selected Attendee" />
                                    <Label fx:id="selectedAttendeeLabel" text="-" wrapText="true" />
                                    <VBox>
                                       <children>
                                          <Label text="Recorded Time:" wrapText="true" />
                                          <Label fx:id="recordedTimeLabel" text="-" wrapText="true">
                                             <font>
                                                <Font name="System Italic" size="12.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                    <VBox layoutX="10.0" layoutY="66.0">
                                       <children>
                                          <Label text="Last Updated:" wrapText="true" />
                                          <Label fx:id="updateTimeLabel" text="-" wrapText="true">
                                             <font>
                                                <Font name="System Italic" size="12.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                        <Separator />
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Set Attendance" />
                              <ComboBox fx:id="attendanceComboBox" maxWidth="1.7976931348623157E308" prefWidth="150.0" />
                              <Button fx:id="resetAttendanceBtn" alignment="CENTER" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#resetAttendance" text="Reset Attendance" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
</VBox>
